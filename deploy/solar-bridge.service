[Unit]
Description=Solar Bridge (Fronius-compatible emulation)
Wants=network-online.target
After=network-online.target

[Service]
# Settings come from the web page (http://<device>/settings). To use a file
# instead, create /etc/solar-bridge/config.yaml (needs the yaml add-on).
ExecStart=/opt/solar-bridge/bin/solar-bridge
Restart=always
RestartSec=5
DynamicUser=yes
StateDirectory=solar-bridge
# Ports 80, 502 and 5353 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
